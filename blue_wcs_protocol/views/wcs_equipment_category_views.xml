<odoo>
  <record id="wcs_equipment_category_view_form" model="ir.ui.view">
    <field name="name">wcs.equipment.category.form.inherit.protocol</field>
    <field name="model">wcs.equipment.category</field>
    <field name="inherit_id" ref="blue_wcs_base.category_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/sheet" position="before">
        <header>
          <button name="action_protocol_ai" type="object" string="AI 生成 / 修改" class="oe_highlight" invisible="adapter_code != 'protocol' or not protocol_profile_id" groups="stock.group_stock_manager"/>
          <button name="action_protocol_validate" type="object" string="试算与验证" invisible="adapter_code != 'protocol' or not protocol_profile_id" groups="stock.group_stock_manager"/>
          <button name="action_protocol_publish" type="object" string="发布生效" invisible="adapter_code != 'protocol' or not protocol_profile_id or protocol_state != 'validated'" groups="stock.group_stock_manager" confirm="发布后, 新作业使用此版本, 已分配作业保留原版本."/>
          <button name="action_protocol_new_draft" type="object" string="从正式版本新建草稿" invisible="adapter_code != 'protocol' or not protocol_profile_id" groups="stock.group_stock_manager"/>
          <button name="action_protocol_rollback" type="object" string="回滚上一版" invisible="adapter_code != 'protocol' or not protocol_release_id" groups="stock.group_stock_manager" confirm="恢复上一正式版本, 已有作业保持原版本."/>
          <field name="protocol_state" widget="statusbar" invisible="adapter_code != 'protocol'"/>
        </header>
      </xpath>
      <field name="equipment_ids" position="replace">
        <field name="protocol_profile_id" invisible="1"/>
        <notebook name="protocol_notebook" invisible="adapter_code != 'protocol' or not protocol_profile_id">
          <page name="requirements" string="需求">
            <field name="protocol_requirements" placeholder="描述厂家接口及文档版本、报文、接受条件和完成位置如何处理"/>
            <group>
              <field name="protocol_draft_source"/>
              <field name="protocol_conversation_ref"/>
            </group>
            <field name="protocol_knowledge_references" invisible="not protocol_knowledge_references"/>
          </page>
          <page name="code" string="可编辑代码">
            <p>代码处理 HTTP / JSON 下发、响应和最终完成回调. 通过 subposition 或 destination_code 决定位置回写, 系统校验后执行. 保存草稿不会自动生效.</p>
            <field name="protocol_code" widget="ace" options="{'mode': 'python'}"/>
          </page>
          <page name="trials" string="试算">
            <field name="protocol_tests" widget="ace" options="{'mode': 'json'}"/>
            <field name="protocol_result"/>
          </page>
          <page name="versions" string="代码版本">
            <field name="protocol_version_ids" readonly="1">
              <list create="0" delete="0">
                <field name="name"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="source"/>
                <field name="content_hash"/>
              </list>
              <form edit="0" create="0">
                <sheet>
                  <group>
                    <field name="name"/>
                    <field name="contract"/>
                    <field name="content_hash"/>
                  </group>
                  <field name="code_text" widget="ace" options="{'mode': 'python'}"/>
                  <field name="test_result"/>
                </sheet>
              </form>
            </field>
          </page>
          <page name="releases" string="发布历史">
            <field name="protocol_release_ids" readonly="1">
              <list create="0" delete="0">
                <field name="name"/>
                <field name="id"/>
                <field name="version_id"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="previous_release_id"/>
              </list>
              <form edit="0" create="0">
                <sheet>
                  <group>
                    <field name="name"/>
                    <field name="content_hash"/>
                  </group>
                  <field name="snapshot"/>
                </sheet>
              </form>
            </field>
          </page>
          <page name="events" string="审计记录">
            <field name="protocol_event_ids" readonly="1">
              <list create="0" delete="0">
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="event_type"/>
                <field name="release_id"/>
                <field name="details"/>
              </list>
            </field>
          </page>
        </notebook>
      </field>
      <field name="adapter_code" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
    </field>
  </record>
  <record id="wcs_equipment_view_form" model="ir.ui.view">
    <field name="name">wcs.equipment.form.inherit.protocol</field>
    <field name="model">wcs.equipment</field>
    <field name="inherit_id" ref="blue_wcs_base.equipment_form"/>
    <field name="arch" type="xml">
      <field name="serial_no" position="after">
        <field name="protocol_device_code" invisible="adapter_code != 'protocol'"/>
      </field>
    </field>
  </record>
  <record id="blue_config_profile_view_form" model="ir.ui.view">
    <field name="name">blue.config.profile.form.inherit.device.protocol</field>
    <field name="model">blue.config.profile</field>
    <field name="inherit_id" ref="blue_config_asset.blue_config_profile_view_form"/>
    <field name="priority">60</field>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='code']/p" position="attributes">
        <attribute name="invisible" add="contract == 'device_protocol/1'" separator=" or "/>
      </xpath>
      <xpath expr="//page[@name='code']" position="inside">
        <p invisible="contract != 'device_protocol/1'">设备协议处理 HTTP / JSON 下发、响应和最终完成回调. 连接参数由人工维护, 代码决定子位置或库存目的库位映射, 固定服务复核后执行.</p>
      </xpath>
      <field name="contract" position="after">
        <field name="device_category_id" readonly="1" invisible="contract != 'device_protocol/1'"/>
      </field>
    </field>
  </record>
</odoo>
