<odoo>
    <record id="request_list" model="ir.ui.view"><field name="name">wcs.request.list</field><field name="model">wcs.request</field><field name="arch" type="xml">
        <list string="WCS作业" default_order="id" create="0" delete="0">
            <header><button name="archive_equipment_request" string="取消" type="object" groups="stock.group_stock_manager" confirm="取消所选尚未下发的WCS作业. 已下发作业须先核对设备."/></header>
            <field name="name"/><field name="create_date" string="创建时间"/><field name="package_id"/><field name="container_id" optional="hide"/>
            <field name="product_id" optional="show"/><field name="product_qty" optional="show"/><field name="product_uom_id" optional="show"/><field name="lot_id" optional="hide"/>
            <field name="location_res_id"/><field name="location_dest_id"/><field name="equipment_id" optional="hide"/><field name="category_id" optional="hide"/>
            <field name="picking_id" optional="hide"/><field name="picking_type_id" optional="hide"/><field name="done_date" optional="hide"/>
            <field name="stage_id" widget="badge"/><field name="role" optional="hide"/>
        </list>
    </field></record>
    <record id="request_form" model="ir.ui.view"><field name="name">wcs.request.form</field><field name="model">wcs.request</field><field name="arch" type="xml">
        <form string="WCS作业" create="0" edit="0" delete="0">
            <header><button name="button_execute" string="执行" type="object" class="oe_highlight" invisible="state != 'pending_send'"/>
                <button name="archive_equipment_request" string="取消" type="object" groups="stock.group_stock_manager" invisible="state not in ['waiting','pending_send','failed']" confirm="确认取消尚未下发的作业?"/>
                <button name="action_open_reconciliation" string="核对设备结果" type="object" groups="stock.group_stock_manager" invisible="state not in ['unknown','sending','failed','accepted','running']"/>
                <field name="stage_id" widget="statusbar"/>
            </header>
            <sheet><field name="state" invisible="1"/><field name="is_simulation" invisible="1"/>
                <div class="oe_button_box" name="button_box"><button name="action_to_picking_id" type="object" class="oe_stat_button" icon="fa-reply" invisible="not picking_id"><div class="o_stat_info"><span class="o_stat_text"><field name="picking_id" readonly="1"/></span></div></button></div>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group><group><field name="product_id"/><label for="product_qty"/><div class="o_row"><field name="product_qty"/><field name="product_uom_id" options="{'no_open':True}"/></div>
                    <field name="lot_id"/><field name="package_id"/><field name="container_id"/><field name="location_res_id"/><field name="location_dest_id"/><field name="picking_type_id"/>
                </group><group><field name="equipment_id"/><field name="category_id"/><field name="maintenance_team_id"/><field name="request_date"/><field name="done_date"/>
                    <field name="company_id" groups="base.group_multi_company"/><field name="priority" widget="priority"/>
                </group></group><group><field name="description"/></group>
                <notebook><page name="goods" string="货物明细"><field name="goods_line_ids" readonly="1"><list create="0" delete="0"><field name="product_id"/><field name="quantity"/><field name="uom_id"/><field name="lot_id"/><field name="package_id"/></list></field></page>
                    <page name="execution" string="执行记录"><group><field name="role"/><field name="predecessor_id"/><field name="dependency_event"/><field name="dependency_point"/><field name="dispatch_date"/></group><field name="event_ids" readonly="1"/></page>
                    <page name="technical" string="技术信息" groups="base.group_system"><group><field name="plan_id"/><field name="step"/><field name="source_point"/><field name="destination_point"/><field name="carrier_code"/><field name="task_type"/></group><field name="payload"/><field name="last_result"/>
                        <group invisible="not is_simulation"><button name="action_simulate_accept" string="模拟设备接受" type="object" invisible="state != 'pending_send'"/><button name="action_simulate_end" string="模拟设备完成" type="object" invisible="state not in ['accepted','running']"/></group>
                    </page>
                </notebook>
            </sheet><chatter/>
        </form>
    </field></record>
    <record id="request_kanban" model="ir.ui.view"><field name="name">wcs.request.kanban</field><field name="model">wcs.request</field><field name="arch" type="xml">
        <kanban default_group_by="stage_id" default_order="id" records_draggable="0" group_create="0" group_delete="0" groups_draggable="0" create="0" delete="0">
            <field name="name"/><field name="stage_id"/><field name="package_id"/><field name="equipment_id"/><field name="product_id"/><field name="location_res_id"/><field name="location_dest_id"/><field name="priority"/>
            <templates><t t-name="card"><div class="o_kanban_record_top"><strong><field name="name"/></strong></div><div class="o_kanban_record_body"><div t-if="record.package_id.raw_value">包裹: <field name="package_id"/></div><div>设备: <field name="equipment_id"/></div><div t-if="record.product_id.raw_value">产品: <field name="product_id"/></div><div>源位置: <field name="location_res_id"/></div><div>目的位置: <field name="location_dest_id"/></div></div><div class="o_kanban_record_bottom"><field name="priority" widget="priority"/></div></t></templates>
        </kanban>
    </field></record>
    <record id="request_search" model="ir.ui.view"><field name="name">wcs.request.search</field><field name="model">wcs.request</field><field name="arch" type="xml"><search><field name="name"/><field name="picking_id"/><field name="equipment_id"/><field name="package_id"/><field name="category_id"/><field name="stage_id"/><filter name="unfinished" string="未完成" domain="[('state','not in',['completed','cancelled'])]"/><group><filter name="stages" string="阶段" context="{'group_by':'stage_id'}"/><filter name="devices" string="设备" context="{'group_by':'equipment_id'}"/><filter name="operations" string="作业类型" context="{'group_by':'picking_type_id'}"/></group></search></field></record>
    <record id="equipment_list" model="ir.ui.view"><field name="name">wcs.equipment.list</field><field name="model">wcs.equipment</field><field name="arch" type="xml"><list><field name="name"/><field name="category_id"/><field name="owner_user_id"/><field name="technician_user_id"/><field name="serial_no"/><field name="maintenance_count"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="equipment_form" model="ir.ui.view"><field name="name">wcs.equipment.form</field><field name="model">wcs.equipment</field><field name="arch" type="xml"><form string="设备"><sheet><field name="adapter_code" invisible="1"/><div class="oe_button_box" name="button_box"><button name="action_to_wcs_requests" type="object" class="oe_stat_button" icon="fa-wrench"><field name="maintenance_count" widget="statinfo" string="WCS作业"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="active" invisible="1"/><field name="category_id"/><field name="owner_user_id"/><field name="technician_user_id"/><field name="maintenance_team_id"/><field name="location"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="task_tmpl"/><field name="model"/><field name="serial_no"/><field name="assign_date"/><field name="effective_date"/><field name="warranty_date"/></group></group><notebook><page string="产品信息"><group><field name="partner_id"/><field name="partner_ref"/><field name="cost"/></group><field name="note"/></page><page string="旧连接参数" groups="base.group_no_one"><group><field name="adapter_code"/><field name="endpoint" groups="base.group_system"/><field name="api_key" password="True" groups="base.group_system"/><field name="api_secret" password="True" groups="base.group_system"/><field name="callback_token" password="True" groups="base.group_system"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="equipment_kanban" model="ir.ui.view"><field name="name">wcs.equipment.kanban</field><field name="model">wcs.equipment</field><field name="arch" type="xml"><kanban><field name="name"/><field name="category_id"/><templates><t t-name="card"><strong><field name="name"/></strong><div><field name="category_id"/></div><div>作业: <field name="maintenance_count"/></div><field name="owner_user_id" widget="many2one_avatar_user"/></t></templates></kanban></field></record>
    <record id="category_form" model="ir.ui.view"><field name="name">wcs.equipment.category.form</field><field name="model">wcs.equipment.category</field><field name="arch" type="xml"><form string="设备类别"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="adapter_code"/><field name="technician_user_id"/></group><group><field name="company_id" groups="base.group_multi_company"/></group></group><group string="连接参数" groups="base.group_system"><field name="ip_post"/><field name="submit_path"/><field name="app_key" password="True"/><field name="app_secret" password="True"/><field name="callback_token" password="True"/></group><field name="equipment_ids"/><field name="note"/></sheet><chatter/></form></field></record>
    <record id="category_list" model="ir.ui.view"><field name="name">wcs.equipment.category.list</field><field name="model">wcs.equipment.category</field><field name="arch" type="xml"><list><field name="name"/><field name="technician_user_id"/><field name="equipment_count"/><field name="maintenance_count"/></list></field></record>
    <record id="team_form" model="ir.ui.view"><field name="name">wcs.team.form</field><field name="model">wcs.team</field><field name="arch" type="xml"><form string="作业团队"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="active" invisible="1"/><field name="member_ids" widget="many2many_tags"/><field name="category_id"/><field name="company_id" groups="base.group_multi_company"/></group></sheet></form></field></record>
    <record id="team_list" model="ir.ui.view"><field name="name">wcs.team.list</field><field name="model">wcs.team</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="category_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="stage_list" model="ir.ui.view"><field name="name">wcs.stage.list</field><field name="model">wcs.stage</field><field name="arch" type="xml"><list editable="top" create="0" delete="0"><field name="sequence" widget="handle"/><field name="name"/><field name="fold"/><field name="is_in_progres"/><field name="done"/></list></field></record>
    <record id="equipment_action" model="ir.actions.act_window"><field name="name">设备</field><field name="res_model">wcs.equipment</field><field name="view_mode">kanban,list,form</field></record>
    <record id="category_action" model="ir.actions.act_window"><field name="name">设备类别</field><field name="res_model">wcs.equipment.category</field><field name="view_mode">list,form</field></record>
    <record id="team_action" model="ir.actions.act_window"><field name="name">作业团队</field><field name="res_model">wcs.team</field><field name="view_mode">list,form</field></record>
    <record id="stage_action" model="ir.actions.act_window"><field name="name">作业阶段</field><field name="res_model">wcs.stage</field><field name="view_mode">list</field></record>
    <record id="request_action" model="ir.actions.act_window"><field name="name">WCS作业</field><field name="res_model">wcs.request</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="request_search"/></record>
    <menuitem id="wcs_menu" name="WCS" sequence="180" groups="stock.group_stock_user" web_icon="blue_wcs_base,static/description/menu_web_icon.png"/>
    <menuitem id="request_menu" name="作业" parent="wcs_menu" action="request_action" sequence="10"/>
    <menuitem id="equipment_menu" name="设备" parent="wcs_menu" action="equipment_action" sequence="20" groups="stock.group_stock_manager"/>
    <menuitem id="category_menu" name="设备类别" parent="wcs_menu" action="category_action" sequence="30" groups="stock.group_stock_manager"/>
    <menuitem id="team_menu" name="作业团队" parent="wcs_menu" action="team_action" sequence="40" groups="stock.group_stock_manager"/>
    <menuitem id="stage_menu" name="作业阶段" parent="wcs_menu" action="stage_action" sequence="50" groups="stock.group_stock_manager"/>
    <record id="route_menu" model="ir.ui.menu"><field name="name">旧版线路资料</field><field name="active" eval="False"/></record>
    <record id="reconciliation_form" model="ir.ui.view"><field name="name">wcs.reconciliation.form</field><field name="model">wcs.reconciliation</field><field name="arch" type="xml"><form><p>先在设备系统或现场核对原任务号, 填写依据后更新本地结果.</p><group><field name="request_id"/><field name="outcome"/><field name="evidence"/></group><footer><button name="action_apply" type="object" string="保存核对结果" class="btn-primary"/><button string="取消" special="cancel"/></footer></form></field></record>
</odoo>
