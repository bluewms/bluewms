<odoo>
    <record id="barcode_workspace_action" model="ir.actions.client">
        <field name="name">条码</field><field name="tag">blue_barcode.workspace</field>
        <field name="target">fullscreen</field>
    </record>
    <menuitem id="barcode_root_menu" name="条码" action="barcode_workspace_action" sequence="35" groups="stock.group_stock_user"/>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.blue.barcode</field>
        <field name="model">stock.picking</field><field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_blue_barcode" type="object" string="扫码作业" class="oe_stat_button" icon="fa-barcode" invisible="state in ('draft','done','cancel')"/>
        </xpath></field>
    </record>
    <record id="stock_picking_batch_form" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.inherit.blue.barcode</field>
        <field name="model">stock.picking.batch</field><field name="inherit_id" ref="stock.stock_picking_batch_form"/>
        <field name="arch" type="xml"><header position="inside">
            <button name="action_blue_barcode" type="object" string="批次扫码" invisible="state in ('done','cancel')"/>
        </header></field>
    </record>
    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.blue.barcode</field>
        <field name="model">stock.picking.type</field><field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml"><xpath expr="//page[@name='hardware']" position="after">
            <page name="blue_barcode" string="条码">
                <group name="blue_barcode_basic" string="基本配置">
                    <field name="blue_barcode_grouping"/>
                    <field name="blue_barcode_allow_overquantity" groups="stock.group_stock_manager"/>
                    <field name="blue_barcode_allow_new_lot" groups="stock.group_stock_manager"/>
                    <field name="blue_barcode_allow_pack" groups="stock.group_stock_manager"/>
                </group>
            </page>
        </xpath></field>
    </record>
</odoo>
