<odoo noupdate="1">
    <!-- Runtime definitions only. Approved generation examples live in Tencent Skill/Wiki. -->
    <record id="blue_scene_template_putaway" model="blue.scene.template">
        <field name="name">上架增强接口 v2</field>
        <field name="hook_code">putaway_policy</field>
        <field name="contract">putaway_policy/2</field>
        <field name="cloud_managed" eval="True"/>
    </record>
    <!-- Retain these identities and batch semantics for existing published scenes. -->
    <record id="blue_scene_template_same_lot" model="blue.scene.template">
        <field name="name">上架接口 v1（原批次策略）</field>
        <field name="active" eval="False"/>
        <field name="cloud_managed" eval="True"/>
    </record>
    <record id="blue_scene_template_same_picking" model="blue.scene.template">
        <field name="name">上架接口 v1（原同单策略）</field>
        <field name="active" eval="False"/>
        <field name="cloud_managed" eval="True"/>
    </record>
    <record id="blue_scene_template_same_batch_name" model="blue.scene.template">
        <field name="name">上架接口 v2（批次号必需）</field>
        <field name="contract">putaway_policy/2</field>
        <field name="requires_batch_names" eval="True"/>
        <field name="active" eval="False"/>
        <field name="cloud_managed" eval="True"/>
    </record>
</odoo>
