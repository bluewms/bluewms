<odoo>
    <data noupdate="1">
        <record id="cron_wcs_create" model="ir.cron">
            <field name="name">WCS: 补偿创建计划</field>
            <field name="model_id" ref="stock.model_stock_picking" />
            <field name="state">code</field>
            <field name="code">model._cron_create_wcs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>
        <record id="cron_wcs_validate" model="ir.cron">
            <field name="name">WCS: 完成后验证库存</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._cron_validate_wcs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
