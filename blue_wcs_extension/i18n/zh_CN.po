msgid "A group must use one pair of position mapping sources."
msgstr "一个分组只能使用一对位置映射源。"

#. module: blue_wcs_extension
#: model:ir.ui.menu,name:blue_wcs_extension.wcs_policy_menu
#: model_terms:ir.ui.view,arch_db:blue_wcs_extension.wcs_preview_form
#: model_terms:ir.ui.view,arch_db:blue_wcs_extension.wcs_type_form
msgid "AI创建配置"
msgstr "AI创建配置"

#. module: blue_wcs_extension
#: model_terms:ir.ui.view,arch_db:blue_wcs_extension.wcs_profile_form
msgid "AI创建配置从全部有效行逐行决定创建、等待或无需WCS, 可调整数量依据、容器组合与位置映射, 再编排单/双/多任务(含同数据后续任务). 设备和任务类型必须使用人工授权. 无绑定时按移动行直接创建. 保存草稿不会生效."
msgstr "AI创建配置从全部有效行逐行决定创建、等待或无需WCS, 可调整数量依据、容器组合与位置映射, 再编排单/双/多任务(含同数据后续任务). 设备和任务类型必须使用人工授权. 无绑定时按移动行直接创建. 保存草稿不会生效."

#. module: blue_wcs_extension
#: model_terms:ir.ui.view,arch_db:blue_wcs_extension.wcs_picking_form
msgid "AI创建配置版本"
msgstr "AI创建配置版本"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:155
msgid "Additional equipment must be active and belong to this company."
msgstr "附加设备必须处于启用状态且属于本公司。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_package.py:20
msgid "Carrier counters require the planning service."
msgstr "承载物计数需要计划服务。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/blue_config_profile.py:48
msgid "Choose a WCS strategy."
msgstr "请选择 WCS 策略。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/wizard/wcs_preview.py:24
msgid "Choose a picking in the strategy company."
msgstr "请选择属于策略公司的调拨单。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:298
msgid "Confirm actual WCS quantities on an open inbound operation."
msgstr "请在未关闭的入库作业上确认 WCS 实际数量。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:296
msgid "Confirm quantities only for enabled WCS operations."
msgstr "只能对已启用 WCS 的作业类型确认数量。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:212
msgid "Confirm the real device supports repeated same-data goods programs before using this orchestration."
msgstr "使用此编排前，请确认真实设备支持相同数据的重复货物程序。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:314
msgid "Create WCS tasks only on open confirmed operations."
msgstr "只能在未关闭且已确认的作业上创建 WCS 任务。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:127
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:52
msgid "Current quantity is below the fixed WCS plan."
msgstr "当前数量低于固定的 WCS 计划。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:118
msgid "Do not combine different physical carriers in one WCS movement."
msgstr "不要在一个 WCS 移动中混合不同实体承载物。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:29
msgid "Do not supply fixed WCS versions directly."
msgstr "请勿直接填写固定的 WCS 版本。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/blue_config_profile.py:33
msgid "Each trial requires name, input and the contract-specific expected result."
msgstr "每个试用用例都需要名称、输入和契约约定的预期结果。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:312
msgid "Enable WCS for this operation type first."
msgstr "请先为此作业类型启用 WCS。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:301
msgid "Enter positive actual quantities and required lots."
msgstr "请输入正数实际数量和必需的批次。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:114
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:109
msgid "Every WCS product must be inventory tracked."
msgstr "所有 WCS 产品必须启用库存跟踪。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:308
msgid "Inventory users are required to plan WCS."
msgstr "规划 WCS 需要库存用户权限。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_move_line.py:20
msgid "Keep stock lines referenced by active WCS plans."
msgstr "请保留被生效 WCS 计划引用的库存行。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:23
msgid "Keep the operation scope fixed while WCS plans exist."
msgstr "存在 WCS 计划时请保持作业范围不变。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:19
msgid "Line decisions require the WCS planning service."
msgstr "行决策需要 WCS 计划服务。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:138
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:126
msgid "One carrier contains several product lines. Use an AI container grouping policy or separate the physical carriers before line-by-line creation."
msgstr "一个承载物包含多个产品行。请使用 AI 集箱策略，或先分隔实体承载物再逐行创建。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:157
msgid "One equipment needs one manually authorized task type."
msgstr "每台设备需要一个手动授权的任务类型。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:116
msgid "One physical carrier must have one source and destination."
msgstr "每个实体承载物必须只有一个源位置和目标位置。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/wizard/wcs_preview.py:20
msgid "Only managers can preview draft strategies."
msgstr "只有管理员才能预览草稿策略。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:147
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:141
msgid "Outbound WCS requires available reserved goods."
msgstr "出库 WCS 需要有可用的预留货物。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:196
msgid "Physical source/destination scopes must contain the fixed inventory locations."
msgstr "实体源/目标范围必须包含固定的库存位置。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:156
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:145
msgid "Plan all contents before moving an entire carrier."
msgstr "移动整承载物前请先计划全部内容。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:404
msgid "Plan and complete the WCS quantities before validating inventory."
msgstr "验证库存前请先规划并完成 WCS 数量。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:129
msgid "Plan the complete carrier quantities; do not split a physical carrier."
msgstr "请按承载物完整数量做计划，不要拆分实体承载物。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/blue_config_profile.py:28
msgid "Provide 1 to 20 WCS trials."
msgstr "请提供 1 到 20 个 WCS 试用用例。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:328
msgid "Publish the bound WCS strategy before creating tasks."
msgstr "创建任务前请先发布绑定的 WCS 策略。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_move_line.py:14
msgid "Reconcile the fixed WCS plan before changing its goods or locations."
msgstr "变更货物或位置前请先对账固定的 WCS 计划。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:165
msgid "The selected position mapping is missing or ambiguous for this group."
msgstr "所选位置映射对此分组缺失或不明确。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking_v4.py:210
msgid "This adapter needs explicit support for area/zone position mappings."
msgstr "此适配器需要显式支持库区/区域位置映射。"

#. module: blue_wcs_extension
#: code:addons/blue_wcs_extension/models/stock_picking.py:101
msgid "This carrier has already moved on this operation. Reconcile remaining goods instead of moving it again."
msgstr "此承载物已在当前作业上移动过。请对账剩余货物，而不是再次移动。"

