[Unit]
Description=BlueWMS authenticated native Wiki read-only gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=bluewms-wiki
Group=bluewms-wiki
ExecStart=/usr/bin/python3 /opt/bluewms-native-wiki/native_wiki_gateway.py --config /etc/bluewms-native-wiki/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
