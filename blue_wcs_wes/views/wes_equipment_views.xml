<odoo>
    <record id="wes_equipment_form" model="ir.ui.view">
        <field name="name">wcs.equipment.wes</field>
        <field name="model">wcs.equipment</field>
        <field name="inherit_id" ref="blue_wcs_base.equipment_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="WES业务映射" invisible="adapter_code != 'wes'">
                    <field name="wes_direction" />
                    <field name="wes_warehouse_code" />
                    <field name="wes_room_code" />
                    <field name="wes_owner_code" />
                    <field name="wes_order_type" />
                    <field name="wes_storage_type" />
                </group>

            </xpath>
        </field>
    </record>
<record id="wes_category_form" model="ir.ui.view"><field name="name">wcs.equipment.category.wes</field><field name="model">wcs.equipment.category</field><field name="inherit_id" ref="blue_wcs_base.category_form"/><field name="arch" type="xml"><field name="submit_path" position="after"><field name="wes_authorization" password="True" invisible="adapter_code != 'wes'"/><field name="wes_token_url" invisible="adapter_code != 'wes'"/><field name="wes_app_id" invisible="adapter_code != 'wes'"/><field name="wes_app_secret" password="True" invisible="adapter_code != 'wes'"/></field></field></record></odoo>
