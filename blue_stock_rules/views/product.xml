<odoo>
    <record id="product_template_rules" model="ir.ui.view">
        <field name="name">product.template.form.inherit.blue_stock_rules</field><field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml"><field name="categ_id" position="after"><field name="allow_negative_stock" invisible="not is_storable" groups="stock.group_stock_manager"/></field></field>
    </record>
    <record id="product_category_rules" model="ir.ui.view">
        <field name="name">product.category.form.inherit.blue_stock_rules</field><field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml"><field name="name" position="after"><field name="allow_negative_stock" groups="stock.group_stock_manager"/></field></field>
    </record>
</odoo>
